{"info":{"_postman_id":"flipplay-modul4-20261125","description":"Koleksi pengujian demo Modul 4 Praktikum Web: FlipPlay (Media ↔ Pengguna, belongsToMany). Jalankan berurutan dari atas ke bawah — request 06 menyimpan id media uji ke variabel media_id, dipakai request 09 dan 16. Server harus jalan dulu: php artisan serve (http://127.0.0.1:8000). Isi request 06–17 sama dengan 17 cek otomatis flipplay-test.py.","name":"FlipPlay — Modul 4 (Laravel REST API)","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"event":[{"listen":"test","script":{"exec":["pm.test(\"Status 200\", function () {","    pm.response.to.have.status(200);","});","","pm.test(\"Total 7 media seed\", function () {","    pm.expect(pm.response.json().meta.total).to.eql(7);","});"],"type":"text/javascript"}}],"name":"01 GET Daftar media","request":{"header":[],"method":"GET","url":{"host":["{{base_url}}"],"path":["api","media"],"raw":"{{base_url}}/api/media"}}},{"event":[{"listen":"test","script":{"exec":["pm.test(\"Status 200\", function () {","    pm.response.to.have.status(200);","});","","pm.test(\"Hanya 1 hasil: Death Note\", function () {","    var json = pm.response.json();","    pm.expect(json.data.length).to.eql(1);","    pm.expect(json.data[0].title).to.eql(\"Death Note\");","});"],"type":"text/javascript"}}],"name":"02 GET Cari media by judul","request":{"header":[],"method":"GET","url":{"host":["{{base_url}}"],"path":["api","media"],"query":[{"key":"title","value":"death"}],"raw":"{{base_url}}/api/media?title=death"}}},{"event":[{"listen":"test","script":{"exec":["pm.test(\"Status 200\", function () {","    pm.response.to.have.status(200);","});","","pm.test(\"3 media Action\", function () {","    pm.expect(pm.response.json().meta.total).to.eql(3);","});"],"type":"text/javascript"}}],"name":"03 GET Filter genre Action","request":{"header":[],"method":"GET","url":{"host":["{{base_url}}"],"path":["api","media"],"query":[{"key":"genre","value":"Action"}],"r